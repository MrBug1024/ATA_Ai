# AI accountant annual-audit backend
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# The Docker-local annual-audit stack. Keep these values isolated per project.
BUSINESS_DOMAIN=annual_audit
ANNUAL_MYSQL_HOST=127.0.0.1
ANNUAL_MYSQL_PORT=53306
ANNUAL_MYSQL_USER=root
ANNUAL_MYSQL_PASSWORD=change-me
ANNUAL_MYSQL_DATABASE=ata_agent
ANNUAL_POSTGRES_PORT=55432
ANNUAL_POSTGRES_DATABASE=ata_agent_platform
ANNUAL_POSTGRES_USER=ata_agent_app
ANNUAL_POSTGRES_PASSWORD=change-me
ANNUAL_REDIS_PORT=56379
ANNUAL_REDIS_PASSWORD=change-me
ANNUAL_REDIS_NAMESPACE=ata:dev:
ANNUAL_MINIO_API_PORT=61000
ANNUAL_MINIO_ACCESS_KEY=ata_annual_local
ANNUAL_MINIO_SECRET_KEY=change-me
ANNUAL_MINIO_BUCKET_RAW=ata-annual-raw
ANNUAL_MINIO_BUCKET_DERIVED=ata-annual-derived
ANNUAL_MINIO_BUCKET_ARTIFACTS=ata-annual-artifacts
ANNUAL_AUTH_LOCAL_JWT_SECRET=change-me-to-a-long-random-secret

# LangGraph and local authentication
LANGGRAPH_CHECKPOINTER=postgres
LANGGRAPH_CHECKPOINTER_AUTO_SETUP=false
AUTH_ENABLED=true
AUTH_IDENTITY_MODE=private
AUTH_DEV_TRUST_HEADERS=false
AUTH_LOCAL_ACCESS_TOKEN_MINUTES=480
AUTH_PASSWORD_MIN_LENGTH=10
HEAVY_PAYLOAD_ENABLE_POSTGRES=true
HEAVY_PAYLOAD_TTL_SECONDS=86400

# OpenAI-compatible model provider
LLM_DEFAULT_PROVIDER=minimax
LLM_PROVIDER_ROUTER=minimax
LLM_PROVIDER_REPORT_A=minimax
LLM_PROVIDER_REPORT_B=minimax
LLM_PROVIDER_AGENT=minimax
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
MINIMAX_MODEL_ROUTER=MiniMax-M2.7
MINIMAX_MODEL_REPORT_A=MiniMax-M2.7
MINIMAX_MODEL_REPORT_B=MiniMax-M2.7
MINIMAX_MODEL_AGENT=MiniMax-M2.7

# Optional OCR service
OCR_BASE_URL=https://ocr.rhzy.ai
OCR_API_KEY=
OCR_TIMEOUT_SECONDS=600
OCR_VERIFY_SSL=false
OCR_BACKEND=vlm-auto-engine
OCR_LANG_LIST=ch
OCR_TABLE_ENABLE_PDF=true
OCR_TABLE_ENABLE_IMAGE=false
OCR_PDF_SPLIT_ENABLED=false

# Upload and annual-audit agent limits
MAX_UPLOAD_FILES=20
MAX_UPLOAD_FILE_MB=500
MAX_IMAGE_FILE_MB=10
OCR_MAX_PARALLEL=5
ENABLE_TASK_AUTOCREATE=true
ENABLE_AGENT_MEMORY=true
ENABLE_REPORT_CACHE=true
AGENT_RECURSION_LIMIT=8
