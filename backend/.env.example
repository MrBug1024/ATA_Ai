# ATA 年度审计后端环境变量模板
# 此文件只保留变量名，不包含任何连接地址、密钥或部署取值。
# 部署时请由受控的 backend/.env 或环境变量提供实际配置。

# ------------------------------------------------------------------------------
# 应用运行
# ------------------------------------------------------------------------------
APP_ENV=
APP_HOST=
APP_PORT=
BUSINESS_DOMAIN=
PLATFORM_PROJECT_CODE=
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=
