# ------------------------------------------------------------------------------
# App runtime
# ------------------------------------------------------------------------------
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8081
# CORS_ALLOW_ORIGINS:
#   允许访问后端的前端来源，多个来源用英文逗号分隔。
#   本地联调可先写 *；若前端单独，建议改成明确域名，例如 http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=*
# CORS_ALLOW_CREDENTIALS:
#   当前端需要携带 cookie / authorization 等凭据时设为 true
CORS_ALLOW_CREDENTIALS=false
# CORS_ALLOW_METHODS:
#   允许的跨域 HTTP 方法，多个方法用英文逗号分隔
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_ALLOW_HEADERS:
#   允许的跨域请求头，多个请求头用英文逗号分隔
CORS_ALLOW_HEADERS=*
# LOG_LEVEL:
#   应用整体日志级别，常用 INFO / DEBUG / WARNING
LOG_LEVEL=INFO
# LOG_DIR:
#   日志目录，应用启动时会自动创建
LOG_DIR=logs
# LOG_APP_FILE_NAME:
#   业务日志当前写入文件名，历史切分文件形如 app.2026-05-06.log
LOG_APP_FILE_NAME=app.log
# LOG_ACCESS_FILE_NAME:
#   访问日志当前写入文件名，历史切分文件形如 access.2026-05-06.log
LOG_ACCESS_FILE_NAME=access.log
# LOG_FILE_BACKUP_COUNT:
#   按天切分后最多保留多少个历史日志文件
LOG_FILE_BACKUP_COUNT=30
# LOG_INCLUDE_REQUEST_FIELDS:
#   true  时日志中附带 request_id / thread_id / case_id
#   false 时只输出基础日志字段
LOG_INCLUDE_REQUEST_FIELDS=true
# LOG_PAYLOAD_PREVIEW_CHARS:
#   记录 query / 外部响应 / payload 预览时的最大字符数，避免日志爆炸
LOG_PAYLOAD_PREVIEW_CHARS=240

# ------------------------------------------------------------------------------
# LLM routing
# 修改 LLM_DEFAULT_PROVIDER 即可切换全局主模型。
# 可选值: minimax / kimi / faker / openai
# 如果某个角色需要单独换厂商，再设置对应的 LLM_PROVIDER_*。
# ------------------------------------------------------------------------------
LLM_DEFAULT_PROVIDER=minimax
LLM_PROVIDER_ROUTER=
LLM_PROVIDER_REPORT_A=
LLM_PROVIDER_REPORT_B=
LLM_PROVIDER_AGENT=
# Phase 2.5.3 灰度开关；business_line 启用七个确定性只读节点、三个专用图和两个领域 Agent；未迁移写能力仍走 legacy。
ROUTER_EXECUTION_MODE=legacy

# ------------------------------------------------------------------------------
# OpenAI-compatible provider: OpenAI
# 仅在 LLM_DEFAULT_PROVIDER=openai 或某个 LLM_PROVIDER_* = openai 时生效。
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ROUTER=gpt-4.1-mini
OPENAI_MODEL_REPORT_A=gpt-4.1
OPENAI_MODEL_REPORT_B=gpt-4.1
OPENAI_MODEL_AGENT=gpt-4.1
OPENAI_TEMPERATURE_ROUTER=0.1
OPENAI_TEMPERATURE_REPORT=0.7
OPENAI_TEMPERATURE_AGENT=0.3

# ------------------------------------------------------------------------------
# LangGraph memory / checkpoint
# postgres: 持久化对话与图状态
# memory:   仅进程内临时状态，重启即失效
# LANGGRAPH_CHECKPOINTER_AUTO_SETUP:
#   true  时允许应用启动后自动执行 LangGraph checkpoint 建表/迁移
#   false 时仅连接已存在的表，推荐先手工执行 sql/langgraph_checkpointer.sql
# LANGGRAPH_MEMORY_WINDOW:
#   组装 memory_context 时，最近消息窗口的参考轮数
# LANGGRAPH_MEMORY_MAX_TOKENS:
#   持久化 messages 前的安全修剪上限，避免对话历史无限膨胀
# LANGGRAPH_MEMORY_SUMMARY_CHARS:
#   被裁掉的旧消息滚动摘要最大字符数
# ------------------------------------------------------------------------------
LANGGRAPH_CHECKPOINTER=postgres
LANGGRAPH_CHECKPOINTER_AUTO_SETUP=false
LANGGRAPH_THREAD_TTL_HOURS=168
LANGGRAPH_MEMORY_WINDOW=12
LANGGRAPH_MEMORY_MAX_TOKENS=1200
LANGGRAPH_MEMORY_SUMMARY_CHARS=1200

# 应用主库，用于 checkpointer / workflow 元数据
POSTGRES_DSN=postgresql+psycopg://user:password@127.0.0.1:5432/ai_hunter
# REDIS_URL:
#   Redis 用于 heavy payload 热缓存，降低重复读取大对象的成本
REDIS_URL=redis://10.0.10.2:6379/0
# ------------------------------------------------------------------------------
# MinIO object storage
# 原始卷宗、页图衍生物、系统产物建议分别落 3 个 bucket
#   AI_HUNTER_MINIO_BUCKET_RAW=ai-hunter-raw
#   AI_HUNTER_MINIO_BUCKET_DERIVED=ai-hunter-derived
#   AI_HUNTER_MINIO_BUCKET_ARTIFACTS=ai-hunter-artifacts
# ------------------------------------------------------------------------------
AI_HUNTER_MINIO_ENABLED=false
AI_HUNTER_MINIO_ENDPOINT=
AI_HUNTER_MINIO_ACCESS_KEY=
AI_HUNTER_MINIO_SECRET_KEY=
AI_HUNTER_MINIO_BUCKET_RAW=
AI_HUNTER_MINIO_BUCKET_DERIVED=
AI_HUNTER_MINIO_BUCKET_ARTIFACTS=
AI_HUNTER_MINIO_USE_SSL=true
# HEAVY_PAYLOAD_TTL_SECONDS:
#   heavy payload 在 Redis 中的缓存时间（秒）
HEAVY_PAYLOAD_TTL_SECONDS=86400
# HEAVY_PAYLOAD_ENABLE_POSTGRES:
#   true  时将 heavy payload 同步持久化到 PostgreSQL，支持服务重启后恢复
#   false 时仅使用 Redis / 内存缓存
HEAVY_PAYLOAD_ENABLE_POSTGRES=true
# HEAVY_PAYLOAD_PRUNE_BATCH_SIZE:
#   单次清理 heavy_payload_store 时的最大处理条数，避免一次删太多
HEAVY_PAYLOAD_PRUNE_BATCH_SIZE=500

# ------------------------------------------------------------------------------
# Unified backend service (AI orchestration + deterministic domain engine)
# ------------------------------------------------------------------------------
UNIFIED_API_BASE_URL=http://127.0.0.1:8081
AUDIT_API_TIMEOUT_SECONDS=600
# 单进程内保留服务 token 校验语义，禁止提交真实 token。
AUDIT_API_TOKEN=

# ------------------------------------------------------------------------------
# OCR service
# ------------------------------------------------------------------------------
OCR_BASE_URL=https://ocr.rhzy.ai
OCR_API_KEY=
OCR_TIMEOUT_SECONDS=600
OCR_VERIFY_SSL=false
OCR_BACKEND=vlm-auto-engine
OCR_LANG_LIST=ch
# PDF OCR 是否启用表格结构识别。
OCR_TABLE_ENABLE_PDF=true
# 单张图片 OCR 是否启用表格结构识别。
OCR_TABLE_ENABLE_IMAGE=false
# PDF OCR 是否自动检测并纠正页面方向。
OCR_AUTO_ROTATE_PDF=false
# 单张图片 OCR 是否自动检测并纠正页面方向。
OCR_AUTO_ROTATE_IMAGE=true
# 是否启用 PDF 主动分段和整卷超时后的分段降级。
OCR_PDF_SPLIT_ENABLED=false
# PDF 达到该文件大小(MB)时主动分段；与页数阈值满足任一条件即可。
OCR_PDF_SPLIT_THRESHOLD_MB=10
# PDF 达到该页数时主动分段；与文件大小阈值满足任一条件即可。
OCR_PDF_SPLIT_THRESHOLD_PAGES=10
# 单个远程 OCR 分段序列化后的最大文件大小(MB)。
OCR_PDF_CHUNK_MAX_MB=8
# 单个远程 OCR 分段包含的最大页数。
OCR_PDF_CHUNK_MAX_PAGES=1
# 单份 PDF 内允许同时处理的分段数；实际总并发仍受 OCR_MAX_PARALLEL 限制。
OCR_PDF_CHUNK_CONCURRENCY=1
# 单个 PDF 分段调用远程 OCR 的读取超时(秒)。
OCR_PDF_CHUNK_TIMEOUT_SECONDS=300
# 单个分段首次失败后允许的最大重试次数。
OCR_PDF_CHUNK_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Legacy split-service overrides (normally leave empty)
# ------------------------------------------------------------------------------
AUDIT_API_BASE_URL=
TASK_API_BASE_URL=
CASE_API_BASE_URL=
KNOWLEDGE_API_BASE_URL=
ENTERPRISE_API_BASE_URL=
DOC_CATEGORY_API_BASE_URL=

# ------------------------------------------------------------------------------
# Wenshu / CPWS retrieval database
# ------------------------------------------------------------------------------
CPWS_DB_HOST=10.0.10.114
CPWS_DB_PORT=5434
CPWS_DB_USER=postgres
CPWS_DB_PASSWORD=
CPWS_DB_NAME=cpwsdata
CPWS_QUERY_LIMIT=5
CPWS_QDRANT_BASE_URL=http://10.0.10.2:6333
CPWS_QDRANT_COLLECTION=case_chunks_000
CPWS_QDRANT_API_KEY=
CPWS_QDRANT_TIMEOUT_SECONDS=30

# 向量检索 embedding 服务
# 支持完整 /v1/embeddings 地址
CPWS_EMBEDDING_BASE_URL=
CPWS_EMBEDDING_API_KEY=
CPWS_EMBEDDING_MODEL=bge-m3
CPWS_EMBEDDING_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# OpenAI-compatible provider: Faker model gateway
# ------------------------------------------------------------------------------
FAKER_MODEL_BASE_URL=https://faker-model.rhzy.ai/v1
FAKER_MODEL_API_KEY=
FAKER_MODEL_ROUTER=vllm/google/gemma-4-26B-A4B-it
FAKER_MODEL_REPORT_A=vllm/google/gemma-4-26B-A4B-it
FAKER_MODEL_REPORT_B=vllm/google/gemma-4-26B-A4B-it
FAKER_MODEL_AGENT=vllm/google/gemma-4-26B-A4B-it

# ------------------------------------------------------------------------------
# OpenAI-compatible provider: Kimi
# ------------------------------------------------------------------------------
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL_ROUTER=kimi/Kimi-k2.6
KIMI_MODEL_REPORT_A=kimi/Kimi-k2.6
KIMI_MODEL_REPORT_B=kimi/Kimi-k2.6
KIMI_MODEL_AGENT=kimi/Kimi-k2.6

# ------------------------------------------------------------------------------
# OpenAI-compatible provider: MiniMax China
# ------------------------------------------------------------------------------
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
MINIMAX_MODEL_ROUTER=MiniMax-M2.7
MINIMAX_MODEL_REPORT_A=MiniMax-M2.7
MINIMAX_MODEL_REPORT_B=MiniMax-M2.7
MINIMAX_MODEL_AGENT=MiniMax-M2.7

# ------------------------------------------------------------------------------
# Upload / batch limits
# ------------------------------------------------------------------------------
MAX_UPLOAD_FILES=20
MAX_UPLOAD_FILE_MB=500
MAX_IMAGE_FILE_MB=10
MAX_FILE_BATCH_COUNT=5
OCR_MAX_PARALLEL=5

# ------------------------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------------------------
# 完整审计/重审提取出督办任务后，是否自动调用任务 API 批量创建；false 仅跳过外部写入，仍保留 extracted_tasks。
ENABLE_TASK_AUTOCREATE=true
ENABLE_AGENT_MEMORY=true
ENABLE_REPORT_CACHE=true
ENABLE_REASONING_TRACE=false
ENABLE_DOC_CATEGORY_API_MOCK=false
# 单次 ReAct Agent 子图的最大递归步数；达到预算前由 RemainingSteps 安全停止，避免工具循环拖垮请求。
AGENT_RECURSION_LIMIT=8

# ------------------------------------------------------------------------------
# 确定性数值引擎（报告口径）
# 标量直接给；结构用 JSON。业务默认值在 env 配置中显式维护，业务逻辑只读取 Settings。
# ------------------------------------------------------------------------------
METRICS_DISCOUNT_RATE=0.12                  # NPV 折现率 r
METRICS_AMOUNT_DECIMALS=4                   # 报告金额小数位（会议口径 4 位）
METRICS_TRANCHE_YEARS={"T1":0.125,"T2":0.875,"T3":1.5}        # 三档年化期数
METRICS_TRANCHE_ALLOCATION={"T1":0.2,"T2":0.5,"T3":0.3}       # 资产净值三档分配比例
METRICS_TRANCHE_WEIGHT={"T1":0.95,"T2":0.85,"T3":0.7}         # 三档回款概率权重
METRICS_ZEROING_REQUIRES=[["查封","案外异议"],["查封","强占"],["查封","物理抗辩"]]  # 极端归零叠加条件

# ------------------------------------------------------------------------------
# 八段式报告配置
# provider 留空时跟随 LLM_PROVIDER_REPORT_A；如需按段分流，显式设置 REPORT_SECTION_PROVIDER_{段号}
# provider 可选：minimax / kimi / faker / openai
# ------------------------------------------------------------------------------
REPORT_SECTION_PROVIDER_1=
REPORT_SECTION_PROVIDER_2=
REPORT_SECTION_PROVIDER_3=
REPORT_SECTION_PROVIDER_4=
REPORT_SECTION_PROVIDER_5=
REPORT_SECTION_PROVIDER_6=
REPORT_SECTION_PROVIDER_7=
REPORT_SECTION_PROVIDER_8=
REPORT_SECTION_TIMEOUT_SECONDS=300
REPORT_SECTION_MAX_COMPLETION_TOKENS_KIMI=24576
REPORT_SECTION_CONCURRENCY=3
REPORT_SECTION_CONCURRENCY_KIMI=3
REPORT_SECTION_CONCURRENCY_MINIMAX=3

# ------------------------------------------------------------------------------
# 回款闭环进度看板提醒阈值（Tier1-3）
# 见 ai_hunter/app/services/progress_service.py:build_board_view
# ------------------------------------------------------------------------------
RECOVERY_OVERDUE_DAYS=60                    # 催收逾期宽限天数：预期到期日+N天仍未收齐才报“催收”提醒
PROFIT_DISTRIBUTION_THRESHOLD_PCT=85        # 利润分配触发阈值：实收/预期 ≥N% 时提示“可启动利润分配”

# ------------------------------------------------------------------------------
# 司法时效看板红黄绿阈值（Tier 2-5；不设则用代码默认 30/90 天）
# 见 ai_hunter/app/graph/deadline_board.py
# ------------------------------------------------------------------------------
DEADLINE_RED_DAYS=30                        # 红色预警：剩余天数 ≤N 天
DEADLINE_YELLOW_DAYS=90                     # 黄色预警：red_days < 剩余 ≤N 天（>N 为安全区）

# ------------------------------------------------------------------------------
# 权限网关（Tier 3）：私有化本地身份 / 用户中心 JWT，授权本项目自管
# 见 ai_hunter/app/auth/ 与 docs/design/06
# ------------------------------------------------------------------------------
AUTH_ENABLED=false                          # false=放行(全权限,灰度)；true=强制鉴权
AUTH_IDENTITY_MODE=private                  # private=私有化本地身份；platform=平台用户中心
USER_CENTER_JWT_ALG=HS256                   # HS256(对称,手验) / RS256(非对称,PyJWT)
USER_CENTER_JWT_SECRET=                     # HS256 密钥(与用户中心约定)
USER_CENTER_JWT_PUBLIC_KEY=                 # RS256 公钥(PEM)
AUTH_DEV_TRUST_HEADERS=true                 # 无有效 JWT 时是否信任 X-User-Id/X-User-Roles 开发头
AUTH_JWT_USER_CLAIM=sub                     # JWT 中用户 id / 名称 / 角色 的 claim 名(默认 sub/name/roles)
AUTH_JWT_NAME_CLAIM=name
AUTH_JWT_ROLES_CLAIM=roles
AUTH_JWT_COMPANY_CLAIM=company              # JWT 中公司/机构 id 的 claim 名
AUTH_JWT_APPS_CLAIM=apps                    # JWT 中可访问产品码列表的 claim 名
AUTH_REQUIRE_PROJECT_ACCESS=false           # platform 模式是否要求 apps 包含 AUTH_PROJECT_CODE
AUTH_PROJECT_CODE=ai_hunter                 # 本项目产品码
AUTH_LEGACY_ROLES_ENABLED=false             # v2 迁移期是否允许 JWT/dev header roles 回退；私有化生产应关闭
AUTH_LOCAL_JWT_SECRET=                      # private 本地登录 JWT HS256 密钥；生产必须配置强随机值
AUTH_LOCAL_ACCESS_TOKEN_MINUTES=480         # 本地 access token 有效期
AUTH_PASSWORD_HASH_ALGO=argon2id            # 本地密码哈希算法
AUTH_PASSWORD_MIN_LENGTH=10                 # 最小密码长度
AUTH_PASSWORD_FAILED_LOCK_THRESHOLD=5       # 连续失败 N 次锁定
AUTH_PASSWORD_LOCK_MINUTES=15               # 锁定分钟数
AUTH_ROLE_PERMISSIONS=                      # 角色→权限映射 JSON 覆盖(空=用代码默认)
