# ATA 年度审计后端环境配置
# 配置按年度审计业务组织；连接地址、数据库、桶、集合和密钥均为本项目专属。
# MySQL / Redis / MinIO 使用线上配置位；PostgreSQL 当前使用项目本地实例。

# ------------------------------------------------------------------------------
# App runtime
# 应用监听、跨域、日志和业务域配置。
# ------------------------------------------------------------------------------
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
BUSINESS_DOMAIN=annual_audit
PLATFORM_PROJECT_CODE=ata_ai
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_APP_FILE_NAME=app.log
LOG_ACCESS_FILE_NAME=access.log
LOG_FILE_BACKUP_COUNT=30
LOG_INCLUDE_REQUEST_FIELDS=true
LOG_PAYLOAD_PREVIEW_CHARS=240

# ------------------------------------------------------------------------------
# LLM routing
# 修改 LLM_DEFAULT_PROVIDER 即可切换全局主模型。
# 可选值：minimax / kimi / faker / openai。
# 某个角色需要单独换供应商时，再设置对应的 LLM_PROVIDER_*。
# ------------------------------------------------------------------------------
LLM_DEFAULT_PROVIDER=minimax
LLM_PROVIDER_ROUTER=minimax
LLM_PROVIDER_REPORT_A=minimax
LLM_PROVIDER_REPORT_B=minimax
LLM_PROVIDER_AGENT=minimax
ROUTER_EXECUTION_MODE=legacy

# ------------------------------------------------------------------------------
# OpenAI-compatible provider: OpenAI
# 仅在 LLM_DEFAULT_PROVIDER=openai 或某个 LLM_PROVIDER_* = openai 时生效。
# 没有线上配置时保持为空。
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ROUTER=gpt-4.1-mini
OPENAI_MODEL_REPORT_A=gpt-4.1
OPENAI_MODEL_REPORT_B=gpt-4.1
OPENAI_MODEL_AGENT=gpt-4.1
OPENAI_TEMPERATURE_ROUTER=0.1
OPENAI_TEMPERATURE_REPORT=0.7
OPENAI_TEMPERATURE_AGENT=0.3

# ------------------------------------------------------------------------------
# LangGraph memory / checkpoint
# postgres：持久化对话与图状态；memory：仅进程内临时状态。
# 本地 PostgreSQL 用于当前开发阶段；线上 PostgreSQL 尚未提供。
# ------------------------------------------------------------------------------
LANGGRAPH_CHECKPOINTER=postgres
LANGGRAPH_CHECKPOINTER_AUTO_SETUP=false
LANGGRAPH_THREAD_TTL_HOURS=168
LANGGRAPH_MEMORY_WINDOW=12
LANGGRAPH_MEMORY_MAX_TOKENS=1200
LANGGRAPH_MEMORY_SUMMARY_CHARS=1200

# ------------------------------------------------------------------------------
# PostgreSQL: local only
# 当前唯一使用本地实例的存储。
# POSTGRES_DSN 留空时由以下主机、端口、库名、用户和密码自动拼接。
# ------------------------------------------------------------------------------
POSTGRES_DSN=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DATABASE=ata_agent_platform
POSTGRES_USER=ata_annual_app
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# MySQL: online
# 年度审计业务库：项目、结构化事实、分析发现、任务和底稿业务状态。
# 请填入 ATA 年度审计线上实例；不要填原不良资产数据库。
# ------------------------------------------------------------------------------
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=ata_ai
MYSQL_USER=
MYSQL_PASSWORD=

# ------------------------------------------------------------------------------
# Redis: online
# 用于 heavy payload、缓存和后续异步任务。
# 请填入 ATA 年度审计线上实例；不要填原不良资产 Redis。
# ------------------------------------------------------------------------------
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_NAMESPACE=ata:online:

# ------------------------------------------------------------------------------
# MinIO object storage: online
# 原始材料、页面/表格预览和报告/底稿成果物分桶保存。
# 请填入 ATA 年度审计线上 MinIO；不要填原不良资产桶和密钥。
# ------------------------------------------------------------------------------
ANNUAL_MINIO_ENABLED=false
ANNUAL_MINIO_ENDPOINT=
ANNUAL_MINIO_ACCESS_KEY=
ANNUAL_MINIO_SECRET_KEY=
ANNUAL_MINIO_BUCKET_RAW=ata-annual-raw
ANNUAL_MINIO_BUCKET_DERIVED=ata-annual-derived
ANNUAL_MINIO_BUCKET_ARTIFACTS=ata-annual-artifacts
ANNUAL_MINIO_USE_SSL=true
ANNUAL_MINIO_PREFIX=annual_audit

# ------------------------------------------------------------------------------
# Annual audit vector scope
# 向量库物理实例可共用，但 collection、模型和维度必须属于年审项目。
# ------------------------------------------------------------------------------
ANNUAL_VECTOR_COLLECTION_PREFIX=ata_annual_audit
ANNUAL_EMBEDDING_MODEL=
ANNUAL_EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------------------------
# Heavy payload
# heavy payload 默认持久化到 PostgreSQL，Redis 用于短期缓存。
# ------------------------------------------------------------------------------
HEAVY_PAYLOAD_TTL_SECONDS=86400
HEAVY_PAYLOAD_ENABLE_POSTGRES=true
HEAVY_PAYLOAD_PRUNE_BATCH_SIZE=500

# ------------------------------------------------------------------------------
# Backend service
# 当前后端已包含年度审计业务，不依赖原项目外部审计服务。
# 后续确有线上服务时，再填写对应地址和令牌。
# ------------------------------------------------------------------------------
AUDIT_API_BASE_URL=
AUDIT_API_TIMEOUT_SECONDS=600
AUDIT_API_TOKEN=
TASK_API_BASE_URL=
CASE_API_BASE_URL=
KNOWLEDGE_API_BASE_URL=
ENTERPRISE_API_BASE_URL=
DOC_CATEGORY_API_BASE_URL=

# ------------------------------------------------------------------------------
# OCR service
# PDF、图片、扫描件和表格材料的 OCR、旋转、拆分和远程调用限制。
# 已有当前项目 OCR 配置直接保留。
# ------------------------------------------------------------------------------
OCR_BASE_URL=https://ocr.rhzy.ai
OCR_API_KEY=
OCR_TIMEOUT_SECONDS=600
OCR_VERIFY_SSL=false
OCR_BACKEND=vlm-auto-engine
OCR_LANG_LIST=ch
OCR_TABLE_ENABLE_PDF=true
OCR_TABLE_ENABLE_IMAGE=true
OCR_AUTO_ROTATE_PDF=true
OCR_AUTO_ROTATE_IMAGE=true
OCR_PDF_SPLIT_ENABLED=false
OCR_PDF_SPLIT_THRESHOLD_MB=10
OCR_PDF_SPLIT_THRESHOLD_PAGES=10
OCR_PDF_CHUNK_MAX_MB=8
OCR_PDF_CHUNK_MAX_PAGES=1
OCR_PDF_CHUNK_CONCURRENCY=1
OCR_PDF_CHUNK_TIMEOUT_SECONDS=300
OCR_PDF_CHUNK_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Business tool services
# 年度审计内置能力优先；未迁移的外部业务服务全部留空。
# ------------------------------------------------------------------------------
TASK_API_BASE_URL=
CASE_API_BASE_URL=
KNOWLEDGE_API_BASE_URL=
ENTERPRISE_API_BASE_URL=
DOC_CATEGORY_API_BASE_URL=

# ------------------------------------------------------------------------------
# OpenAI-compatible provider: Faker model gateway
# 可选测试供应商；没有 ATA 线上配置时保持为空。
# ------------------------------------------------------------------------------
FAKER_MODEL_BASE_URL=
FAKER_MODEL_API_KEY=
FAKER_MODEL_ROUTER=
FAKER_MODEL_REPORT_A=
FAKER_MODEL_REPORT_B=
FAKER_MODEL_AGENT=

# ------------------------------------------------------------------------------
# OpenAI-compatible provider: Kimi
# 可选供应商；没有 ATA 线上配置时保持为空。
# ------------------------------------------------------------------------------
KIMI_BASE_URL=
KIMI_API_KEY=
KIMI_MODEL_ROUTER=
KIMI_MODEL_REPORT_A=
KIMI_MODEL_REPORT_B=
KIMI_MODEL_AGENT=

# ------------------------------------------------------------------------------
# OpenAI-compatible provider: MiniMax China
# 当前主模型；已有当前项目配置直接保留。
# ------------------------------------------------------------------------------
MINIMAX_BASE_URL=https://model.rhzy.ai/v1
MINIMAX_API_KEY=
MINIMAX_MODEL_ROUTER=MiniMax-M2.7
MINIMAX_MODEL_REPORT_A=MiniMax-M3
MINIMAX_MODEL_REPORT_B=MiniMax-M3
MINIMAX_MODEL_AGENT=MiniMax-M3
REPORT_SECTION_MAX_COMPLETION_TOKENS_KIMI=24576

# ------------------------------------------------------------------------------
# Upload / batch limits
# 上传数量、单文件大小、图片大小和 OCR 并发。
# ------------------------------------------------------------------------------
MAX_UPLOAD_FILES=20
MAX_UPLOAD_FILE_MB=500
MAX_IMAGE_FILE_MB=10
MAX_FILE_BATCH_COUNT=5
OCR_MAX_PARALLEL=5

# ------------------------------------------------------------------------------
# Feature flags
# 年度审计当前运行开关。
# ------------------------------------------------------------------------------
ENABLE_TASK_AUTOCREATE=true
ENABLE_AGENT_MEMORY=true
ENABLE_REPORT_CACHE=true
ENABLE_REASONING_TRACE=false
ENABLE_DOC_CATEGORY_API_MOCK=false
AGENT_RECURSION_LIMIT=8

# ------------------------------------------------------------------------------
# Annual audit deterministic metrics
# 保留原项目数值引擎配置段格式；不良资产专用 tranche/归零参数不带入年度审计。
# 缺少审计业务口径时保持为空。
# ------------------------------------------------------------------------------
METRICS_AMOUNT_DECIMALS=
METRICS_CURRENCY=
METRICS_MATERIALITY_RULESET_VERSION=
METRICS_SAMPLING_RULESET_VERSION=
METRICS_CONFIRMATION_RULESET_VERSION=

# ------------------------------------------------------------------------------
# Eight-section report
# provider 留空时跟随 LLM_PROVIDER_REPORT_A。
# 报告段、并发和超时参数保持原项目配置风格，具体年度审计口径后续确认。
# ------------------------------------------------------------------------------
REPORT_SECTION_PROVIDER_1=
REPORT_SECTION_PROVIDER_2=
REPORT_SECTION_PROVIDER_3=
REPORT_SECTION_PROVIDER_4=
REPORT_SECTION_PROVIDER_5=
REPORT_SECTION_PROVIDER_6=
REPORT_SECTION_PROVIDER_7=
REPORT_SECTION_PROVIDER_8=
REPORT_SECTION_TIMEOUT_SECONDS=300
REPORT_SECTION_MAX_COMPLETION_TOKENS_KIMI=24576
REPORT_SECTION_CONCURRENCY=3
REPORT_SECTION_CONCURRENCY_KIMI=3
REPORT_SECTION_CONCURRENCY_MINIMAX=3

# ------------------------------------------------------------------------------
# Deadline board
# 年度审计项目截止日看板阈值；未确认业务口径前保持为空。
# ------------------------------------------------------------------------------
DEADLINE_RED_DAYS=
DEADLINE_YELLOW_DAYS=

# ------------------------------------------------------------------------------
# Authentication gateway
# 当前使用私有化本地身份；平台用户中心配置暂留空。
# AUTH_PROJECT_CODE 已切换为 annual_audit，避免沿用原项目产品码。
# ------------------------------------------------------------------------------
AUTH_ENABLED=true
AUTH_IDENTITY_MODE=private
USER_CENTER_JWT_ALG=HS256
USER_CENTER_JWT_SECRET=
USER_CENTER_JWT_PUBLIC_KEY=
AUTH_DEV_TRUST_HEADERS=false
AUTH_JWT_USER_CLAIM=sub
AUTH_JWT_NAME_CLAIM=name
AUTH_JWT_ROLES_CLAIM=roles
AUTH_JWT_COMPANY_CLAIM=company
AUTH_JWT_APPS_CLAIM=apps
AUTH_REQUIRE_PROJECT_ACCESS=false
AUTH_PROJECT_CODE=annual_audit
AUTH_LEGACY_ROLES_ENABLED=false
AUTH_LOCAL_JWT_SECRET=
AUTH_LOCAL_ACCESS_TOKEN_MINUTES=480
AUTH_PASSWORD_HASH_ALGO=argon2id
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_FAILED_LOCK_THRESHOLD=5
AUTH_PASSWORD_LOCK_MINUTES=15
AUTH_ROLE_PERMISSIONS=
