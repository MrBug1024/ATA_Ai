# Copy to .env.local.  .env.local is ignored by Git and must contain only
# development secrets for this isolated local stack.

ANNUAL_POSTGRES_PORT=55432
ANNUAL_POSTGRES_DATABASE=ata_agent_platform
ANNUAL_POSTGRES_USER=ata_annual_app
ANNUAL_POSTGRES_PASSWORD=

ANNUAL_MYSQL_PORT=53306
ANNUAL_MYSQL_DATABASE=ata_ai
ANNUAL_MYSQL_USER=ata_ai_app
ANNUAL_MYSQL_PASSWORD=
ANNUAL_MYSQL_ROOT_PASSWORD=

ANNUAL_REDIS_PORT=56379
ANNUAL_REDIS_PASSWORD=

ANNUAL_MINIO_API_PORT=61000
ANNUAL_MINIO_CONSOLE_PORT=61001
ANNUAL_MINIO_ACCESS_KEY=ata_annual_local
ANNUAL_MINIO_SECRET_KEY=
ANNUAL_MINIO_BUCKET_RAW=ata-annual-raw
ANNUAL_MINIO_BUCKET_DERIVED=ata-annual-derived
ANNUAL_MINIO_BUCKET_ARTIFACTS=ata-annual-artifacts

# Used by scripts/start-annual-audit-backend.ps1.  Redis is optional at the
# application layer, even though the complete local stack provides one.
ANNUAL_REDIS_NAMESPACE=ata:local:
ANNUAL_BACKEND_PORT=8080
ANNUAL_AUTH_LOCAL_JWT_SECRET=
ANNUAL_BOOTSTRAP_SUPERADMIN_PASSWORD=
